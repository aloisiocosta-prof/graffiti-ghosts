{
  "$schema": "https://unpkg.com/wrangler@4.126.0/config-schema.json",
  "name": "graffiti-ghosts",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}

